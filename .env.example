# Provider selection: auto | mock | grok | openai
# auto uses Grok when GROK_API_KEY or XAI_API_KEY is set,
# otherwise OpenAI when OPENAI_API_KEY is set, otherwise the offline mock.
LEDGER_PROVIDER=auto

# xAI Grok, OpenAI-compatible chat completions. Either key name works.
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.7
GROK_BASE_URL=https://api.x.ai/v1

# OpenAI. Used when --provider openai, or when auto has no Grok key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Append-only reasoning log. Each line is one sealed step.
LEDGER_PATH=ledger.jsonl
