{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epistemic-ledger.dev/schema/entry.v1.json",
  "title": "Epistemic Ledger Protocol entry",
  "description": "One JSONL record in Epistemic Ledger Protocol 1.0. Entries that omit version are legacy 1.0 records written before the field was required of new writers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["index", "timestamp", "session_id", "step", "hash_alg", "payload", "prev_hash", "hash"],
  "properties": {
    "version": {"const": "1.0"},
    "index": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "minLength": 20},
    "session_id": {"type": "string", "minLength": 1, "pattern": "^[^\\n\\r]*$"},
    "step": {
      "enum": ["question", "decompose", "evidence", "score", "answer", "checkpoint", "witness"]
    },
    "hash_alg": {"const": "sha256"},
    "signer": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
    "prev_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"type": "object"}
  },
  "dependentRequired": {
    "signature": ["signer"],
    "signer": ["signature"]
  },
  "allOf": [
    {
      "if": {"properties": {"step": {"const": "question"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "provider", "model"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "decompose"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claims"],
            "properties": {
              "claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "text"],
                  "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "text": {"type": "string", "minLength": 1},
                    "renamed_from": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "evidence"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "reasoning", "supports", "caveats", "quality", "self_confidence", "notes"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "reasoning": {"type": "string"},
              "supports": {"type": "array", "items": {"type": "string"}},
              "caveats": {"type": "array", "items": {"type": "string"}},
              "quality": {"enum": ["direct", "inferred", "speculative", "unsupported"]},
              "self_confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "score"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "formula", "quality_weights", "claims", "overall"],
            "properties": {
              "method": {"const": "structural-evidence-v1"},
              "formula": {"type": "string", "minLength": 1},
              "quality_weights": {
                "type": "object",
                "additionalProperties": false,
                "required": ["direct", "inferred", "speculative", "unsupported"],
                "properties": {
                  "direct": {"type": "number"},
                  "inferred": {"type": "number"},
                  "speculative": {"type": "number"},
                  "unsupported": {"type": "number"}
                }
              },
              "claims": {"type": "array", "minItems": 1},
              "overall": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "formula", "confidence", "speculative_discount_applied", "claim_count"],
                "properties": {
                  "method": {"const": "geometric-mean-with-speculative-discount"},
                  "formula": {"type": "string"},
                  "confidence": {"type": "number"},
                  "speculative_discount_applied": {"type": "boolean"},
                  "claim_count": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "answer"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["answer", "uncertainties", "overall_confidence", "method"],
            "properties": {
              "answer": {"type": "string", "minLength": 1},
              "uncertainties": {"type": "array", "items": {"type": "string"}},
              "overall_confidence": {"type": "number"},
              "method": {"const": "structural-evidence-v1"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "checkpoint"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "root", "leaf_count", "first_index", "last_index"],
            "properties": {
              "algorithm": {"const": "merkle-sha256-v1"},
              "root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "leaf_count": {"type": "integer", "minimum": 1},
              "first_index": {"type": "integer", "minimum": 0},
              "last_index": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"step": {"const": "witness"}}, "required": ["step"]},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "stance", "note", "witness_name"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "stance": {"enum": ["attest", "dispute"]},
              "note": {"type": "string"},
              "witness_name": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
